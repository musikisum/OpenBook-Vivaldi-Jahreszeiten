        <PageObject XPosition="766.142362204724" YPosition="1854.6462992126" OwnPage="4" ItemID="1543263246" ItemType="4" Width="459.212598425197" Height="700.15748031496" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="0" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L459.213 0 L459.213 700.157 L0 700.157 L0 0 Z" ContourLinePath="M0 0 L459.213 0 L459.213 700.157 L0 700.157 L0 0 Z" gXpos="766.142362204724" gYpos="1854.6462992126" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content Font="Arial Regular" FontSize="14" Chars="Vor­wor­t"/>
                <para/>
                <Content Chars="Die Vio­lin­kon­zer­te "/>
                <para/>
                <Content Chars="Die­ses OpenBook ba­siert auf Ma­te­ri­ali­en, die im letz­ten Jahr der För­de­rung der Open Mu­sic Aca­de­my durch die Stif­tung In­no­va­ti­on in der Hoch­schul­leh­re ent­stan­den sin­d (2025). Die zu die­sem Heft ge­hör­den­den pro­fes­si­o­nel­len Au­dio und Vi­deo­bei­spie­le sind be­reits auf der Open Mu­sic Aca­de­my ver­öf­fent­licht wor­den und ste­hen dort un­ter der Li­zenz CC BY zur rechts­si­che­ren Nach­nut­zung zur Ver­fü­gung. "/>
                <para/>
                <Content Chars="Mein Dank gilt den fan­tas­ti­schen Mu­si­ke­rin­nen und Mu­si­ker der Hof­ka­pel­le Mün­chen, ins­be­son­de­re Isa­bel­la Bi­son (Ma­na­gement) und Rü­di­ger Lot­ter (Vio­li­ne und Lei­tung) die sich be­reit­er­klärt ha­ben, den für ein Pro­fi-Or­ches­ter si­cher­lich noch un­ge­wöhn­li­chen Weg kul­tu­rell frei­er Li­zen­zen (Crea­ti­ve-Com­mons-Li­zen­zen) zu ge­hen, Lu­kas Ei­che­nau­er und Ma­thi­as Kup­c­zyk für die Vi­deoauf­nah­men, Do­minik Bil­lin­ger für die Au­dio­auf­nah­men, Shinta Wal­ker für das Um­schlag­bild (mit der Vio­li­ne mei­nes Opas) und Dr. Il­ka Mes­te­ma­cher für die wie im­mer zu­ver­läs­si­ge Or­ga­ni­sa­ti­ons­ar­beit. Und ich Dan­ke mei­ner lieben Frau Re­gi­na für das auf­spüh­ren von Recht­schreib­feh­lern, die den Maschi­nen und mir nicht auf­ge­fal­len sin­d."/>
                <para/>
                <Content Chars="Karls­feld, den xx. ... 2026"/>
                <breakline/>
                <Content Chars="Ul­rich Kai­ser"/>
                <trail Alignment="2"/>
